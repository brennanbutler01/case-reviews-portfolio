# Optional real Auth0 configuration. The dev:demo command needs none of these.
VITE_BACKEND_API=http://127.0.0.1:5190
VITE_ROOT=http://127.0.0.1:5189
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_API=
VITE_AUTH0_CALLBACK_URL=http://127.0.0.1:5189/callback

# Connect to an isolated visitor-demo API; never enable the static portfolio mode with this.
VITE_VISITOR_DEMO=false
