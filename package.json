{
    "name": "case-reviews",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "format": "prettier --w .",
        "test": "vitest",
        "test:e2e": "playwright test --config playwright.local.config.ts",
        "dev:demo": "VITE_DEMO_MODE=true VITE_BACKEND_API=http://127.0.0.1:5190 VITE_ROOT=http://127.0.0.1:5189 vite --host 127.0.0.1 --port 5189 --strictPort",
        "test:ci": "vitest run --maxWorkers=1",
        "test:e2e:local": "playwright test --config playwright.local.config.ts",
        "build:portfolio": "tsc && VITE_PORTFOLIO_DEMO=true vite build",
        "test:e2e:portfolio": "playwright test --config playwright.portfolio.config.ts",
        "deploy:portfolio": "corepack yarn build:portfolio && python3 scripts/deploy_portfolio.py"
    },
    "dependencies": {
        "@auth0/auth0-react": "2.24.1",
        "@emotion/react": "11.14.0",
        "@mantine/core": "6.0.22",
        "@mantine/dates": "6.0.22",
        "@mantine/form": "6.0.22",
        "@mantine/hooks": "6.0.22",
        "@mantine/modals": "6.0.22",
        "@mantine/notifications": "6.0.22",
        "@react-pdf/renderer": "4.9.0",
        "@tabler/icons-react": "2.47.0",
        "dayjs": "1.11.23",
        "mantine-react-table": "1.3.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "7.18.3",
        "swr": "2.5.1",
        "uuid": "11.1.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@playwright/test": "1.63.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "14.3.1",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "20.19.43",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "@vitejs/plugin-react-swc": "4.3.3",
        "@vitest/coverage-v8": "4.1.11",
        "dotenv": "16.6.1",
        "eslint": "8.57.1",
        "eslint-plugin-react-hooks": "4.6.2",
        "eslint-plugin-react-refresh": "0.4.20",
        "http-status-codes": "2.3.0",
        "jsdom": "29.1.1",
        "prettier": "2.8.8",
        "resize-observer-polyfill": "1.5.1",
        "typescript": "5.9.3",
        "vite": "7.3.6",
        "vite-tsconfig-paths": "4.3.2",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": ">=24.13.0 <25"
    },
    "packageManager": "yarn@1.22.22"
}
