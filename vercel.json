{
  "buildCommand": "corepack yarn build:visitor",
  "installCommand": "corepack yarn install --frozen-lockfile",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "portfolio-refresh": false
    }
  }
}
